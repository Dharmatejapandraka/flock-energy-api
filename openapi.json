{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy — Urja Meter Ops API",
    "version": "1.0.0",
    "description": "Read-only wrapper around the Urja Meter Ops portal. The runtime FastAPI schema at /openapi.json is authoritative after implementation changes."
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "responses": {"200": {"description": "Service is running"}}
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create or refresh the portal session",
        "responses": {
          "200": {"description": "Session request completed"},
          "502": {"description": "Portal authentication failed"}
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": ["Meters"],
        "summary": "List meters",
        "responses": {
          "200": {"description": "Meter data returned"},
          "502": {"description": "Upstream portal error"}
        }
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter details",
        "parameters": [{"name": "meter_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Meter details returned"},
          "404": {"description": "Meter not found"},
          "502": {"description": "Upstream portal error"}
        }
      }
    },
    "/api/v1/meters/{meter_id}/consumption": {
      "get": {
        "tags": ["Consumption"],
        "summary": "Get consumption history",
        "parameters": [{"name": "meter_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Consumption data returned"},
          "404": {"description": "Meter or data not found"},
          "502": {"description": "Upstream portal error"}
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "tags": ["Hierarchy"],
        "summary": "Get network hierarchy (optional extension)",
        "responses": {
          "200": {"description": "Hierarchy data returned"},
          "502": {"description": "Upstream portal error"}
        }
      }
    }
  }
}
