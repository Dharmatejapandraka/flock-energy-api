# Copy to .env and fill in credentials locally. Never commit .env.
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_USERNAME=operator@urja.local
PORTAL_PASSWORD=replace-with-provided-password

# These are placeholders. Verify them in browser DevTools before use.
PORTAL_LOGIN_PATH=/login
PORTAL_METERS_PATH=/meters
PORTAL_METER_DETAIL_PATH=/meters/{meter_id}
PORTAL_CONSUMPTION_PATH=/meters/{meter_id}/consumption
PORTAL_HIERARCHY_PATH=/hierarchy
PORTAL_USERNAME_FIELD=username
PORTAL_PASSWORD_FIELD=password
REQUEST_TIMEOUT_SECONDS=20
VERIFY_TLS=true
